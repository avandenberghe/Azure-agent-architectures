# Copy to .env and fill in. Never commit .env.
#
# .env is the only place real identifiers live. Nothing tracked by git should
# contain a subscription ID, a tenant ID or a project endpoint.

# Copy this from ai.azure.com -> your project -> welcome screen.
# Do not construct it by hand; the format has changed between versions.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# The DEPLOYMENT name you chose, not the model's real name.
FOUNDRY_MODEL=<deployment-name>

# Used by az commands, not by the Python code.
#   az account show --query tenantId -o tsv
#   az account show --query id -o tsv
AZURE_TENANT_ID=<tenant-guid>
AZURE_SUBSCRIPTION_ID=<subscription-guid>

# The resource and its group, for the az calls in local_agent/ops_agent.py.
AZURE_FOUNDRY_RESOURCE=<foundry-resource-name>
AZURE_RESOURCE_GROUP=<resource-group-name>
AZURE_REGION=<region>
